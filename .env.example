# ========================================================
# CONFIGURACIÓN SQL SERVER (DINÁMICA GERENCIAL)
# ========================================================
SQL_SERVER=localhost
SQL_PORT=1433
SQL_USER=sa
SQL_PASSWORD=tu_password_aqui
SQL_ENCRYPT=false
SQL_TRUST_CERT=true

# ========================================================
# CONFIGURACIÓN DE GOOGLE WORKSPACE / DRIVE API
# ========================================================
# Opción A: OAuth2 (Igual que en estudios-errados)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Opción B: Cuenta de servicio (opcional, si no usas OAuth2)
GOOGLE_SERVICE_ACCOUNT_FILE=

# ID de la carpeta en Google Drive donde se encuentran los archivos Excel / Sheets
# (Se puede extraer de la URL de Drive: https://drive.google.com/drive/folders/ID_DE_LA_CARPETA)
GOOGLE_DRIVE_FOLDER_ID=

# ========================================================
# CONFIGURACIÓN DE TABLAS Y MAPEO
# ========================================================
# Prefijo de las tablas generadas con inicial (BGD_MATRIZ_3100_A, BGD_MATRIZ_3100_C, etc.)
TABLE_PREFIX=BGD_MATRIZ_3100_

# Columna a indexar por fecha (si está vacía, se auto-detecta la primera columna tipo fecha)
DATE_INDEX_COLUMN=fecha

# Nombre de la aplicación Spark
SPARK_APP_NAME=RPA_Drive_To_SQLServer
